opam-version: "2.0"
name: "ledgerwallet-mavryk"
authors: ["Vincent Bernardoff <vb@luminar.eu.org>" "Mavryk Dynamics <info@mavryk.io>"]
maintainer: "Mavryk Dynamics <info@mavryk.io>"
license: "ISC"
homepage: "https://github.com/mavryk-network/ocaml-ledger-wallet"
bug-reports: "https://github.com/mavryk-network/ocaml-ledger-wallet/issues"
dev-repo: "git+https://github.com/mavryk-network/ocaml-ledger-wallet"
build:    [ "dune" "build"   "-p" name "-j" jobs ]
# run-test: [ "dune" "runtest" "-p" name "-j" jobs ]
depends: [
  "ocaml" {>= "4.08.0"}
  "dune" {>= "2.4.0"}
  "ledgerwallet"
  "uecc" { with-test }
  "hex" { with-test }
  "secp256k1-internal" # { with-test } # commented because github actions does not install external deps for test only deps
  "alcotest-lwt" { with-test }
]
synopsis: "Ledger wallet library for OCaml: Mavryk app"
description:"""
"""
